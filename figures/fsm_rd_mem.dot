digraph fsm_rd_mem {
  graph [rankdir=LR, bgcolor="white", pad=0.28, margin=0, nodesep=0.68, ranksep=0.96, splines=spline, outputorder=edgesfirst, forcelabels=true, fontname="Arial", fontsize=16, label="vc_mvp_rd_mem request/response FSM (A/B/Col/Ref instances)", labelloc=t, labeljust=c];
  node [shape=rect, style="rounded,filled", fixedsize=true, width=2.55, height=0.68, fontname="Arial", fontsize=10.5, color="#62758A", fillcolor="#EAF0F6", fontcolor="#263442", penwidth=1.2];
  edge [fontname="Arial", fontsize=9, color="#4B5563", fontcolor="#374151", penwidth=1.05, arrowsize=0.72];

  reset [shape=point, width=0.13, height=0.13, label="", color="#315B7D", fillcolor="#315B7D"];
  idle  [label="MEM_IDLE", fillcolor="#E8F3EA", color="#6F8F78"];
  get   [label="MEM_GET"];
  drain [label="MEM_CHK_DQ", fillcolor="#FBF4DC", color="#A18A48"];

  reset -> idle [label="!vc_rst_z or reg_slice_go", color="#315B7D", fontcolor="#315B7D", penwidth=1.55];
  idle -> get [label="ip_cu_start", color="#315B7D", fontcolor="#315B7D", penwidth=1.55];
  idle -> idle [label="!ip_cu_start", color="#8A94A3", fontcolor="#626D7A", style=dashed, constraint=false];
  get -> drain [label="last_hsk = (mem_cnt==mem_avail_cnt-1) && mem2ip_gnt", color="#315B7D", fontcolor="#315B7D", penwidth=1.5];
  get -> get [label="!last_hsk", color="#8A94A3", fontcolor="#626D7A", style=dashed, constraint=false];
  drain -> idle [label="!n_empty_n", color="#8A94A3", fontcolor="#626D7A", style=dashed, constraint=false, minlen=2];
  drain -> drain [label="n_empty_n", color="#8A94A3", fontcolor="#626D7A", style=dashed, constraint=false];
}
