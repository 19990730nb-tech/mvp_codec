digraph fsm_cand_gen_merge {
  graph [rankdir=LR, bgcolor="white", pad=0.28, margin=0, nodesep=0.62, ranksep=0.92, splines=spline, outputorder=edgesfirst, forcelabels=true, fontname="Arial", fontsize=16, label="vc_mvp_cand_gen Merge FSM", labelloc=t, labeljust=c];
  node [shape=rect, style="rounded,filled", fixedsize=true, width=2.65, height=0.68, fontname="Arial", fontsize=10.5, color="#62758A", fillcolor="#EAF0F6", fontcolor="#263442", penwidth=1.2];
  edge [fontname="Arial", fontsize=9, color="#4B5563", fontcolor="#374151", penwidth=1.05, arrowsize=0.72];

  reset [shape=point, width=0.13, height=0.13, label="", color="#315B7D", fillcolor="#315B7D"];
  idle [label="CAND_IDLE", fillcolor="#E8F3EA", color="#6F8F78"];
  wc   [label="CAND_WAIT_SCALE_C", fillcolor="#FBF4DC", color="#A18A48"];
  done [label="CAND_DONE", fillcolor="#F7EBDD", color="#A77B50"];

  reset -> idle [label="!vc_rst_z or reg_slice_go", color="#315B7D", fontcolor="#315B7D", penwidth=1.55];
  idle -> idle [label="!cand_cu_start", color="#8A94A3", fontcolor="#626D7A", style=dashed, constraint=false];
  idle -> wc [label="cand_cu_start && selected temporal candidate needs scaling", color="#315B7D", fontcolor="#315B7D", penwidth=1.5];
  idle -> done [label="cand_cu_start && no scale wait required"];
  wc -> wc [label="!scale_done", color="#8A94A3", fontcolor="#626D7A", style=dashed, constraint=false];
  wc -> done [label="scale_done", color="#315B7D", fontcolor="#315B7D", penwidth=1.55];
  done -> idle [label="unconditional", color="#8A94A3", fontcolor="#626D7A", style=dashed, constraint=false, minlen=2];
}
