digraph fsm_mrg_mc_done {
  graph [rankdir=LR, bgcolor="white", pad=0.32, margin=0, nodesep=0.72, ranksep=1.12, splines=spline, outputorder=edgesfirst, forcelabels=true, fontname="Arial", fontsize=16, label="ve_mrg_top per-PU MC-done FSM", labelloc=t, labeljust=c];
  node [shape=rect, style="rounded,filled", fixedsize=true, width=2.35, height=0.68, fontname="Arial", fontsize=10.5, color="#62758A", fillcolor="#EAF0F6", fontcolor="#263442", penwidth=1.2];
  edge [fontname="Arial", fontsize=9, color="#4B5563", fontcolor="#374151", penwidth=1.05, arrowsize=0.72];

  reset [shape=point, width=0.13, height=0.13, label="", color="#315B7D", fillcolor="#315B7D", group=main];
  idle [label="MC_IDLE", fillcolor="#E8F3EA", color="#6F8F78", group=main];
  w0   [label="MC_WAIT_HSK_0", fillcolor="#FBF4DC", color="#A18A48", group=main];
  w1   [label="MC_WAIT_HSK_1", fillcolor="#FBF4DC", color="#A18A48", group=main];
  done [label="MC_DONE", fillcolor="#F7EBDD", color="#A77B50", group=main];
  legend [shape=note, fixedsize=false, style="filled", color="#B8C2CC", fillcolor="#F5F7F9", fontcolor="#4B5563", fontsize=9, margin="0.16,0.12", label="E = reg_avc_mode ? mrg2mc_cand_rdy[i]\n    : (cand_rdy[1] && blk_en[i])\nC1 = cand1_ena[i]\nF0 = candidate0 flow in MRG_MC_CAND_RDY\nH = mrg2mc_cand_hsk[i]\nD = cand_diff[i]"];

  reset -> idle [label="!vc_rst_z\n(or slice reset for active lane)", color="#315B7D", fontcolor="#315B7D", penwidth=1.55, weight=10];
  idle -> idle [label="!E", color="#8A94A3", fontcolor="#626D7A", style=dashed, constraint=false];
  idle -> w1 [label="E && C1 && (F0 || H)", constraint=false];
  idle -> w0 [label="E && C1 && !F0 && !H", color="#315B7D", fontcolor="#315B7D", penwidth=1.45, weight=10];
  idle -> done [label="E && !C1 && (F0 || H)", constraint=false];
  idle -> w0 [label="E && !C1 && !F0 && !H", color="#315B7D", fontcolor="#315B7D", penwidth=1.45, weight=10];
  w0 -> w0 [label="!H", color="#8A94A3", fontcolor="#626D7A", style=dashed, constraint=false];
  w0 -> w1 [label="H && D", color="#315B7D", fontcolor="#315B7D", penwidth=1.5, weight=10];
  w0 -> done [label="H && !D", constraint=false];
  w1 -> w1 [label="!H", color="#8A94A3", fontcolor="#626D7A", style=dashed, constraint=false];
  w1 -> done [label="H", color="#315B7D", fontcolor="#315B7D", penwidth=1.55, weight=10];
  done -> idle [label="unconditional", color="#8A94A3", fontcolor="#626D7A", style=dashed, constraint=false, minlen=2];

  { rank=sink; legend; }
}
